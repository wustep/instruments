{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/(piano|violin|viola|cello|bass|flute|oboe|trumpet|double-bass|contrabass|grand|upright|orchestra|ensemble|measurements|notes)",
      "destination": "/index.html"
    },
    {
      "source": "/(piano|violin|viola|cello|bass|flute|oboe|trumpet|double-bass|contrabass|grand|upright|orchestra|ensemble|measurements|notes)/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/designs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "ignoreCommand": "bash -c 'case \"$VERCEL_GIT_COMMIT_REF\" in claude/*|codex/*|agent/*) echo \"agent branch: no preview\"; exit 0;; *) exit 1;; esac'"
}
